{
  "id": "./",
  "name": "FreshTag — Tem thông minh, bữa ăn an tâm",
  "short_name": "FreshTag",
  "description": "Quét tem sinh học để biết độ tươi, truy xuất nguồn gốc và nhận gợi ý món ngon. Bản demo mobile-first trên GitHub Pages.",
  "lang": "vi",
  "dir": "ltr",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "portrait-primary",
  "background_color": "#f4f4ec",
  "theme_color": "#064e3b",
  "categories": ["food", "health", "utilities", "education"],
  "prefer_related_applications": false,
  "icons": [
    {
      "src": "assets/icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "assets/icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "assets/icons/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "assets/icons/icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    }
  ]
}
